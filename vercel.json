{
  "buildCommand": "mkdir -p dist && cp *.html index.css index.js *.png *.ico *.mp4 dist/ 2>/dev/null || true && cp -r pokk dist/ 2>/dev/null || true && cp -r dashboard-assets dist/ 2>/dev/null || true && cp robots.txt sitemap.xml dist/ 2>/dev/null || true",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/case-study-dashboard", "destination": "/case-study-dashboard.html" },
    { "source": "/case-study-call-agent", "destination": "/case-study-call-agent.html" },
    { "source": "/case-study-email-campaign", "destination": "/case-study-email-campaign.html" },
    { "source": "/case-study-outreach", "destination": "/case-study-outreach.html" },
    { "source": "/case-study-whatsapp-clinic", "destination": "/case-study-whatsapp-clinic.html" },
    { "source": "/case-study-whatsapp-agent", "destination": "/case-study-whatsapp-agent.html" }
  ]
}
